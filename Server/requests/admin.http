# Admin API Endpoint
# NOTE: requires role EMPLOYEE or ADMIN (see SecurityConfig). /api/auth/register
# always creates a USER - promote a test account directly in Mongo first, e.g.:
#   db.customer.updateOne({phone: "0888703040"}, {$set: {role: "ADMIN"}})

## Login as EMPLOYEE/ADMIN - captures accessToken
# @name login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "phone": "0888703040",
  "password": "Pass123@"
}
###
## Get dashboard stats (bus/ticket/invoice/customer counts, revenue)
GET http://localhost:8080/api/admin/stats
Authorization: Bearer {{login.response.body.$.accessToken}}
###
## Get dashboard stats - no auth token (expect 401/403)
GET http://localhost:8080/api/admin/stats
###
## Get dashboard stats - as a plain USER (expect 403 Forbidden)
# Log in with a non-EMPLOYEE/ADMIN account (e.g. register a fresh one in user.http)
# and paste its accessToken below to exercise this case.
GET http://localhost:8080/api/admin/stats
Authorization: Bearer PASTE_USER_ROLE_ACCESS_TOKEN_HERE
