# Tickets API Endpoint
# NOTE: everything except GET /{id}/phone/{phone-number} requires authentication;
# DELETE requires EMPLOYEE/ADMIN.

## Login - captures accessToken
# @name login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "phone": "0888703040",
  "password": "Pass123@"
}
###
## Get all tickets
GET http://localhost:8080/api/tickets
Authorization: Bearer {{login.response.body.$.accessToken}}
###
## Get a specific ticket by ID
@ticketid=69a55380c527dc545010b6ce
GET http://localhost:8080/api/tickets/{{ticketid}}
Authorization: Bearer {{login.response.body.$.accessToken}}
###
## Get a ticket by ID + phone number (public - used for guest ticket lookup)
GET http://localhost:8080/api/tickets/{{ticketid}}/phone/0888703040
###
## Get a ticket by ID + wrong phone number (expect 404/403)
GET http://localhost:8080/api/tickets/{{ticketid}}/phone/0999999999
###
## Create a new ticket (bypasses the Redis hold/TTL flow used by /api/bookings)
@busid=69a55380c527dc545010b6ce
POST http://localhost:8080/api/tickets
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "busId": "{{busid}}",
  "customerId": "{{login.response.body.$.customerId}}",
  "seats": ["A1", "A2"],
  "totalFare": 590000,
  "boardingPoint": "Bến xe An Sương",
  "droppingPoint": "Bến Lội",
  "name": "Huỳnh Thế Long",
  "phone": "0888703040",
  "email": "longhuynh@fubabus.com"
}
###
## Create a new ticket - missing name (expect 400, fails @NotEmpty validation)
POST http://localhost:8080/api/tickets
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "busId": "{{busid}}",
  "customerId": "{{login.response.body.$.customerId}}",
  "seats": ["A3"],
  "totalFare": 295000,
  "boardingPoint": "Bến xe An Sương",
  "droppingPoint": "Bến Lội",
  "phone": "0888703040"
}
###
## Create a new ticket - invalid phone format (expect 400, fails @Pattern validation)
POST http://localhost:8080/api/tickets
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "busId": "{{busid}}",
  "seats": ["A4"],
  "totalFare": 295000,
  "boardingPoint": "Bến xe An Sương",
  "droppingPoint": "Bến Lội",
  "name": "Invalid Phone",
  "phone": "12345"
}
###
## Delete a ticket (requires EMPLOYEE/ADMIN)
DELETE http://localhost:8080/api/tickets/{{ticketid}}
Authorization: Bearer {{login.response.body.$.accessToken}}
