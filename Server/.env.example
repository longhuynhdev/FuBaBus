# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
# Get it from: Atlas Dashboard → Connect → Drivers → copy the URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>

# The database name inside your Atlas cluster
MONGODB_DATABASE=FuBaBus

# A strong password for the Redis container running on this VPS
# Generate one with: openssl rand -base64 32
REDIS_PASSWORD=change_me_to_a_strong_random_password

# Base64-encoded signing key for JWT access tokens.
# Must decode to at least 64 bytes (HS512) or the app refuses to start.
# Generate one with: openssl rand -base64 64
# If left unset the app generates a random key at startup, which means every restart
# invalidates all issued tokens and multiple instances reject each other's tokens.
JWT_SECRET=change_me_run_openssl_rand_base64_64
